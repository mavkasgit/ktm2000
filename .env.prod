# === KTM-2000 Production Environment ===
OPS_PUBLIC_IP=192.168.100.200

# External access
EXTERNAL_PORT=8082
BASE_URL=http://192.168.100.200:8082

# Database
POSTGRES_USER=ktm2000_user
POSTGRES_PASSWORD=ktm2000_prod_pass
POSTGRES_DB=ktm2000_prod
POSTGRES_DATA_PATH=../../data/postgres-prod
POSTGRES_CONTAINER_NAME=ktm2000-postgres-prod

# Internal URLs
DATABASE_URL=postgresql+asyncpg://ktm2000_user:ktm2000_prod_pass@postgres:5432/ktm2000_prod
BACKEND_INTERNAL_URL=http://backend:8000

# Public URLs (derived from BASE_URL)
APP_PUBLIC_URL=http://192.168.100.200:8082/api
CORS_ORIGINS=*

# App settings
SECRET_KEY=ktm2000-prod-secret-key-change-in-production
ENV=prod
DEFAULT_TIMEZONE=Europe/Moscow

# Storage
STORAGE_PATH=../../storage
UPLOAD_DIR=./data/uploads
BACKUPS_PATH=./data/backups
PRODUCT_PHOTO_DIR=/app/storage/products
IMPORT_STORAGE_DIR=/app/storage/imports

# === App JWT (per-app — never share with HRMS; SSO is Authentik only) ===
JWT_SECRET_KEY=ktm2000-jwt-prod-secret-change-in-production


# === OIDC / Authentik bridge (SSO) ===
AUTH_OIDC_ENABLED=true
# Browser-facing issuer (authorize + id_token.iss)
AUTH_OIDC_ISSUER=http://192.168.100.200:9000/application/o/ktm2000/
AUTH_OIDC_CLIENT_ID=ktm2000
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=http://192.168.100.200:8082/auth/callback
AUTH_OIDC_SCOPES=openid profile email
# Server-side from Docker → host Authentik (not container localhost)
AUTH_OIDC_TOKEN_URL=http://192.168.100.200:9000/application/o/token/
AUTH_OIDC_JWKS_URL=http://192.168.100.200:9000/application/o/ktm2000/jwks/
AUTH_OIDC_ALLOW_JIT=true
AUTH_OIDC_DEFAULT_ROLE=admin

# Break Glass (emergency access when Authentik unreachable)
BREAK_GLASS_ENABLED=true
BREAK_GLASS_PASSWORD=__CHANGE_ME_IN_PRODUCTION__
