# === KTM-2000 Development Environment ===
OPS_PUBLIC_IP=192.168.100.200

# External access
EXTERNAL_PORT=5180
BASE_URL=http://localhost:5180

# Database
POSTGRES_USER=ktm2000_user
POSTGRES_PASSWORD=ktm2000_pass
POSTGRES_DB=ktm2000_dev
POSTGRES_PORT=5432
POSTGRES_DATA_PATH=../data/postgres-dev
POSTGRES_CONTAINER_NAME=ktm2000-postgres

# Internal URLs
DATABASE_URL=postgresql+asyncpg://ktm2000_user:ktm2000_pass@localhost:5432/ktm2000_dev
BACKEND_INTERNAL_URL=http://backend:8000

# Public URLs (derived from BASE_URL)
APP_PUBLIC_URL=${BASE_URL}/api
CORS_ORIGINS=http://localhost:5180

# App settings
SECRET_KEY=ktm2000-dev-secret-change-me
ENV=dev
DEFAULT_TIMEZONE=Europe/Moscow

# Storage
STORAGE_PATH=../storage
UPLOAD_DIR=./data/uploads
BACKUPS_PATH=./data/backups
PRODUCT_PHOTO_DIR=/app/storage/products
IMPORT_STORAGE_DIR=/app/storage/imports
DEV_BYPASS_AUTH=true
# Per-app JWT only — never share with HRMS; SSO is Authentik
JWT_SECRET_KEY=ktm2000-jwt-dev-secret-change-me

# === OIDC / Authentik bridge (SSO, optional dev) ===
AUTH_OIDC_ENABLED=true
AUTH_OIDC_ISSUER=http://192.168.100.200:9000/application/o/ktm2000/
AUTH_OIDC_CLIENT_ID=ktm2000
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=http://localhost:5180/auth/callback
AUTH_OIDC_SCOPES=openid profile email
AUTH_OIDC_ALLOW_JIT=false

# Break Glass (emergency access when Authentik unreachable)
BREAK_GLASS_ENABLED=true
BREAK_GLASS_PASSWORD=break-glass-dev

# Unified profile SoT (Authentik Admin API)
AUTHENTIK_API_URL=http://192.168.100.200:9000
AUTHENTIK_API_TOKEN=ak-bootstrap-dev-token-local-not-prod
AUTHENTIK_PUBLIC_URL=http://192.168.100.200:9000

