# =============================================================================
# KTM-2000 — эталонный пример переменных окружения
# =============================================================================
# Скопируй в .env / .env.dev / .env.test / .env.prod и заполни реальными
# значениями (секреты — сгенерируй на месте). Не коммить реальные .env*.
#
# Файлы, которые это читают:
#   - backend/app/core/config.py        (pydantic-settings, env_file по ENV_FILE)
#   - infra/compose/docker-compose.*.yml (подстановка ${VAR} в environment/volumes)
#   - frontend: VITE_API_URL / VITE_API_BASE_URL (Vite, только dev-сборка)
#
# Как запускать:
#   prod:  cd infra/compose && docker compose -f docker-compose.prod.yml up -d --build
#   dev:   backend python -m uvicorn app.main:app --reload  (+ frontend vite)
#
# ENV_FILE: config.py по умолчанию берёт .env.dev рядом с проектом. Для prod
#           контейнер получает переменные через env_file: ../../.env.prod.
#
# Порт: прод nginx слушает EXTERNAL_PORT (8082), внутри — 80/8000.
# =============================================================================

# -----------------------------------------------------------------------------
# LAN-адрес хоста — ЕДИНЫЙ для всех трёх проектов (authentik/ktm2000/hrms).
# Подставляется в BASE_URL, OIDC-issuer, redirect, HRMS_BASE_URL.
# Узнать: ipconfig → IPv4 активного адаптера (не 127.0.0.1).
# -----------------------------------------------------------------------------
OPS_PUBLIC_IP=192.168.100.200

# -----------------------------------------------------------------------------
# Внешний доступ
# -----------------------------------------------------------------------------
# Порт, который nginx публикует наружу (прод = 8082, dev = 5180, test = 8081).
EXTERNAL_PORT=8082
# Публичный URL приложения (браузер пользователя). ${VAR} раскрывает config.py.
BASE_URL=http://${OPS_PUBLIC_IP}:8082

# -----------------------------------------------------------------------------
# База данных (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=ktm2000_user
# ПАРОЛЬ БД — СЕКРЕТ. Генерировать на месте: openssl rand -base64 24.
# Должен совпадать с POSTGRES_PASSWORD и с паролем в DATABASE_URL.
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=ktm2000_prod
# Внешний порт Postgres (для подключения извне; в compose dev — 127.0.0.1:${DEV_POSTGRES_PORT}).
POSTGRES_PORT=5432
# Порт Postgres в dev-compose (см. infra/compose/docker-compose.dev.yml).
DEV_POSTGRES_PORT=5440
# Путь, куда compose монтирует данные Postgres (bind-mount; относительно infra/compose).
POSTGRES_DATA_PATH=../../data/postgres-prod
# Имя контейнера Postgres — нужно скриптам бэкапов (docker exec).
POSTGRES_CONTAINER_NAME=ktm2000-postgres-prod
# DSN для SQLAlchemy. Внутри compose-сети host = postgres, порт = 5432.
# ПАРОЛЬ В DSN — СЕКРЕТ, дублирует POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://ktm2000_user:change-me-postgres-password@postgres:5432/ktm2000_prod

# -----------------------------------------------------------------------------
# Внутренние URL (внутри compose-сети)
# -----------------------------------------------------------------------------
# Внутренний адрес бэкенда для других сервисов (nginx/интеграции).
BACKEND_INTERNAL_URL=http://backend:8000
# Публичный URL API (используется для абсолютных ссылок/ссылок на файлы).
APP_PUBLIC_URL=http://${OPS_PUBLIC_IP}:8082/api
# CORS: * — любые origin (для LAN/prod). Список через запятую при необходимости.
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Приложение: секреты и JWT
# -----------------------------------------------------------------------------
# Django/FastAPI-стиль секрет приложения — СЕКРЕТ, длинный (>40 символов).
# Используется как fallback для JWT, если не задан JWT_SECRET_KEY.
SECRET_KEY=change-me-app-secret-key-min-40-chars
# Основной HS256-ключ подписи JWT — СЕКРЕТ. ОБЯЗАТЕЛЬНО свой для KTM,
# НЕЛЬЗЯ делить с HRMS (SSO — только через Authentik, не общий HS256).
JWT_SECRET_KEY=change-me-ktm-jwt-secret-key
# Время жизни access-токена, минуты (дефолт 1440 = сутки).
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Алгоритм подписи JWT. Не менять без необходимости.
ALGORITHM=HS256
# Окружение: dev | test | prod. Меняет пути данных и флаги безопасности.
ENV=prod
DEFAULT_TIMEZONE=Europe/Moscow
# Dev/test only: true разрешает magic Bearer "admin" и fallback system@local.
# В prod ОБЯЗАТЕЛЬНО false (строгий JWT; magic-токен → 401).
DEV_BYPASS_AUTH=false
# Пул соединений с БД (настройка производительности).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# true = логировать все SQL-запросы (только для отладки).
SQL_ECHO=false

# -----------------------------------------------------------------------------
# Break Glass (аварийный вход, когда Authentik недоступен)
# -----------------------------------------------------------------------------
# true = разрешён аварийный вход emergency_admin через POST /api/auth/break-glass/login.
# Пароль проверяется по env-конфигу, НЕ по БД.
BREAK_GLASS_ENABLED=true
# Логин аварийного пользователя.
BREAK_GLASS_USER=emergency_admin
# ПАРОЛЬ аварийного входа — СЕКРЕТ. При заданном BREAK_GLASS_PASSWORD
# хэш игнорируется (приоритет у открытого пароля).
BREAK_GLASS_PASSWORD=change-me-break-glass-password
# Альтернатива: bcrypt-хэш вместо открытого пароля (для реального прод).
BREAK_GLASS_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# OIDC / Authentik bridge (SSO). false = вход только через Break Glass.
# -----------------------------------------------------------------------------
# Включить OIDC-вход через Authentik.
AUTH_OIDC_ENABLED=true
# Issuer — per-app: путь обязан заканчиваться слагом приложения.
# Формат: http://<OPS_PUBLIC_IP>:9000/application/o/<slug>/
AUTH_OIDC_ISSUER=http://${OPS_PUBLIC_IP}:9000/application/o/ktm2000/
# Публичный client id (= слаг приложения в Authentik).
AUTH_OIDC_CLIENT_ID=ktm2000
# Пусто для public+PKCE клиента. Заполняй только для confidential BFF.
AUTH_OIDC_CLIENT_SECRET=
# Redirect URI — точное совпадение с allow-list провайдера.
# Dev :5180 · Prod :8082. Пусто → config.py выведет из APP_PUBLIC_URL.
AUTH_OIDC_REDIRECT_URI=http://${OPS_PUBLIC_IP}:8082/auth/callback
# Скоупы: обязательны openid + кастомный ktm_access (для маппинга claims).
AUTH_OIDC_SCOPES=openid profile email ktm_access
# Доп. хосты (или полные issuer'ы) через запятую, принимаемые в id_token.iss
# (LAN IP, localhost, host.docker.internal и т.п.).
AUTH_OIDC_ISSUER_ALIASES=${OPS_PUBLIC_IP},localhost,127.0.0.1,host.docker.internal
# Опциональные переопределения URL. Пусто → выводятся из issuer/discovery.
AUTH_OIDC_AUTHORIZATION_URL=
AUTH_OIDC_TOKEN_URL=
AUTH_OIDC_JWKS_URL=
AUTH_OIDC_END_SESSION_URL=
# true = создавать локального User при первом OIDC-входе (JIT).
# false = 403, если нет привязки (authentik_sub/username/email).
AUTH_OIDC_ALLOW_JIT=true
# Роль для JIT / когда SYNC off и нет совпадения по группам (MES: admin|planner|…).
AUTH_OIDC_DEFAULT_ROLE=viewer
# true = мягко маппить IdP-группы → users.role при link/JIT.
# false = приложение — источник истины для MES-ролей.
AUTH_OIDC_SYNC_ROLE_FROM_IDP=true
# SSO-only флаг (информационный в /auth/oidc/config): парольные пути удалены.
AUTH_SSO_ONLY=false
# true = показывать hint «вход через SSO» на странице логина.
AUTH_OIDC_LOGIN_HINT_ENABLED=true

# -----------------------------------------------------------------------------
# Authentik Admin API (профиль пользователя: имя/аватар).
# Токен живёт только на бэкенде, НИКОГДА в VITE_*.
# -----------------------------------------------------------------------------
# URL API: абсолютный или "auto" (детект LAN IP хоста в рантайме).
# В Docker BE→IdP обычно: http://host.docker.internal:9000
AUTHENTIK_API_URL=auto
# ПАРОЛЬ/ТОКЕН — СЕКРЕТ. Создать в Authentik: Directory → Tokens (admin).
# Пусто = API-профиль отключён (только deep-link'и).
AUTHENTIK_API_TOKEN=change-me-authentik-api-token
# Публичный URL Authentik (для абсолютных ссылок). "auto" или http://host:9000.
AUTHENTIK_PUBLIC_URL=auto
# TTL кеша профиля пользователя (секунды) — как часто ходить в Authentik API.
AUTHENTIK_PROFILE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Аудит входов
# -----------------------------------------------------------------------------
# Окно (в днях) для истории входов /auth/me/login-events.
LOGIN_EVENTS_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Хранилище (bind-mount на хост)
# -----------------------------------------------------------------------------
# Корень хранения файлов (относительно compose-каталога). prod: ../../storage.
STORAGE_PATH=../../storage
# Каталог загрузок (относительно корня проекта; dev без compose).
UPLOAD_DIR=./data/uploads
# Каталог бэкапов БД (бэкапы делаются docker exec в POSTGRES_CONTAINER_NAME).
BACKUPS_PATH=./data/backups
# Каталоги внутри контейнера (не менять без нужды — заданы в Dockerfile).
PRODUCT_PHOTO_DIR=/app/storage/products
IMPORT_STORAGE_DIR=/app/storage/imports

# -----------------------------------------------------------------------------
# Интеграция с HRMS (синхронизация сотрудников)
# -----------------------------------------------------------------------------
# Базовый URL HRMS (прод nginx :8081). Связан с OPS_PUBLIC_IP.
HRMS_BASE_URL=http://${OPS_PUBLIC_IP}:8081
# Служебный токен для API HRMS (если требуется, кроме X-Service-Key).
# СЕКРЕТ — генерировать на месте.
HRMS_API_TOKEN=change-me-hrms-api-token

# -----------------------------------------------------------------------------
# Frontend (Vite, только dev-сборка; в prod статика собирается в образ)
# -----------------------------------------------------------------------------
# Базовый URL API для запросов из браузера. Пусто/нет → "/api" (тот же origin).
# VITE_API_URL=http://${OPS_PUBLIC_IP}:8082/api
# VITE_API_BASE_URL=http://${OPS_PUBLIC_IP}:8082/api
