# === KTM-2000 Environment Configuration ===
# Copy this file to .env.dev, .env.test, or .env.prod and fill in the values.
# Never commit actual secrets to version control.

# External access
EXTERNAL_PORT=
BASE_URL=

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_DATA_PATH=

# Internal URLs
DATABASE_URL=
BACKEND_INTERNAL_URL=http://backend:8000

# Public URLs (derived from BASE_URL)
APP_PUBLIC_URL=
CORS_ORIGINS=

# App settings
SECRET_KEY=
# Preferred JWT signing key (falls back to SECRET_KEY).
# MUST be per-app (ktm-specific) — never reuse HRMS/shared-sso secret.
# Cross-app SSO is Authentik OIDC only, not a shared HS256 key.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENV=
DEFAULT_TIMEZONE=Europe/Moscow

# Dev/test only: fallback to system@local when no Bearer; also gates magic Bearer "admin"
# Must be false in production (strict JWT).
DEV_BYPASS_AUTH=false

# --- OIDC / Authentik bridge (dual-run) ---
# When false: local password + OTP only. When true: SSO stub + ?password=1 escape.
AUTH_OIDC_ENABLED=false
# Issuer path ends with app slug, trailing slash preferred:
#   http://localhost:9000/application/o/ktm2000/
AUTH_OIDC_ISSUER=
# Public client id (= Authentik application slug)
AUTH_OIDC_CLIENT_ID=ktm2000
# Empty for public+PKCE client
AUTH_OIDC_CLIENT_SECRET=
# FE callback hint; browser uses {origin}/auth/callback when possible
# Dev :5180 · Prod :8082
AUTH_OIDC_REDIRECT_URI=http://localhost:5180/auth/callback
AUTH_OIDC_SCOPES=openid profile email
# Comma-separated extra hosts (or full URLs) accepted in id_token.iss (LAN IP, etc.)
AUTH_OIDC_ISSUER_ALIASES=
# Optional URL overrides (Docker often needs host.docker.internal for token/JWKS)
AUTH_OIDC_AUTHORIZATION_URL=
AUTH_OIDC_TOKEN_URL=
AUTH_OIDC_JWKS_URL=
AUTH_OIDC_END_SESSION_URL=
# Auto-create local User on first OIDC login (default false; prod opt-in only)
AUTH_OIDC_ALLOW_JIT=false
# Role for JIT / when SYNC off and no group match (MES enum: admin|planner|…)
AUTH_OIDC_DEFAULT_ROLE=viewer
# When true, soft-map IdP groups → users.role on link/JIT; default false = app SoT for MES roles
AUTH_OIDC_SYNC_ROLE_FROM_IDP=false

# Storage
STORAGE_PATH=
UPLOAD_DIR=
BACKUPS_PATH=
PRODUCT_PHOTO_DIR=/app/storage/products
IMPORT_STORAGE_DIR=/app/storage/imports
