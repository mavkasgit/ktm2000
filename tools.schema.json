{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mavkasgit/ktm2000/tools.schema.json",
  "title": "Реестр инструментов KTM-2000",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated", "tools"],
  "properties": {
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "repo",
        "category",
        "version",
        "pinned_in",
        "runs_at",
        "blocking",
        "last_reviewed",
        "rationale"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "category": {
          "enum": [
            "language",
            "linter",
            "typechecker",
            "test-runner",
            "coverage",
            "e2e",
            "database",
            "migration",
            "hook",
            "ci-action",
            "dev-tool"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Как закреплено в pinned_in: пин (0.16.9), мажор (24), диапазон (>=7.4.0) или absent."
        },
        "pinned_in": {
          "type": "string",
          "minLength": 1,
          "description": "Путь от корня репозитория (файл или каталог *.yml) либо absent — закрепления нет."
        },
        "runs_at": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["commit", "push", "gate", "ci", "manual"] }
        },
        "blocking": { "type": "boolean" },
        "last_reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "rationale": { "type": "string", "minLength": 8 },
        "npm_package": {
          "type": "string",
          "description": "Имя npm-пакета, если инструмент ставится через package.json."
        }
      }
    }
  }
}
