{
  "name": "ktm-2000-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/heavy.mjs -- tsc -b && node ../scripts/heavy.mjs -- vite build",
    "lint": "node ../scripts/heavy.mjs -- eslint .",
    "lint:ratchet": "node ../scripts/heavy.mjs -- node scripts/lint-ratchet.mjs",
    "lint:strict": "node ../scripts/heavy.mjs -- eslint . --max-warnings=0",
    "typecheck": "node ../scripts/heavy.mjs -- tsc -b",
    "typecheck:e2e": "node ../scripts/heavy.mjs -- tsc -p tsconfig.e2e.json --noEmit",
    "prebuild": "node ../scripts/verify-sync.mjs --other ../hrms --if-enabled",
    "preview": "vite preview",
    "test": "node ../scripts/heavy.mjs -- vitest run",
    "e2e:prep": "node ../scripts/verify-sync.mjs --other ../hrms --if-enabled && npm --prefix .. run db:e2e:up && npm --prefix .. run db:e2e:wait && npm --prefix .. run db:e2e:prep-db",
    "e2e:run": "node e2e/run-tier.mjs",
    "test:e2e": "npm run e2e:run -- all",
    "test:e2e:smoke": "npm run e2e:run -- smoke",
    "test:e2e:ui": "npm run e2e:run -- ui-e2e",
    "test:e2e:ui:narrow": "npm run e2e:run -- ui-narrow",
    "test:e2e:mobile": "npm run e2e:run -- mobile",
    "test:e2e:ui-mode": "npm run e2e:run -- ui-e2e --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@multiavatar/multiavatar": "^1.0.7",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@user/ui": "file:./shared-ui",
    "@xyflow/react": "^12.12.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
