# === KTM-2000 E2E-стенд ===
# Источник правды для стенда Playwright: отдельная БД, отдельные порты,
# отдельное файловое хранилище. Общая dev-БД (`.env.dev`, 5440) и devstack
# (8012/5172) стенду не принадлежат — прогон идёт параллельно с чужой работой.
#
# Файл закоммичен: секретов здесь нет (тестовый Postgres, пароль из
# docker-compose.test.yml), а копировать его руками перед прогоном не нужно.
# Переопределение на уровне окружения работает: переменная из process.env
# важнее значения ниже (из файла добираются только те, которых нет в окружении).

# --- Адреса стенда: их нет, и это не баг ---
# Backend и frontend стенда слушают **свободные порты, которые ОС выдаёт на
# каждый прогон** (`listen(0)` в [`frontend/scripts/run-e2e.mjs`]). Запуск идёт
# только через npm-скрипты (`npm run test:e2e` и `test:e2e:*`) — они и
# подставляют порты в `E2E_API_URL` и `PLAYWRIGHT_TEST_BASE_URL` (окружение
# важнее файла). Статический адрес в этом файле означал бы, что у стенда есть
# порт, который можно занять: прерванный прогон оставлял бы сокет в LISTENING
# и следующий прогон падал бы на `… is already used` — то есть на уборке
# предыдущего, а не на своей проверке.
#
# Прогон против уже поднятого стека (отладка) — единственный случай с явными
# адресами: `PW_REUSE_STACK=1` плюс `E2E_API_URL`/`PLAYWRIGHT_TEST_BASE_URL`,
# заданные руками. Пример — в [`frontend/e2e/AGENTS.md`](frontend/e2e/AGENTS.md).

# --- База данных: отдельная, на тестовом Postgres (не dev!) ---
# Один сервер Postgres на 5441 обслуживает и pytest-прогоны, и E2E, но базы
# у них разные: прогоны E2E ходят в `ktm2000_e2e` и не видят и не чистят
# чужих данных.
# `npm run db:e2e:create` (scripts/e2e-db.py) создаёт её и отказывается
# работать, если DSN нацелен на общую dev-БД.
DATABASE_URL=postgresql+asyncpg://ktm2000_user:ktm2000_pass_test@localhost:5441/ktm2000_e2e
E2E_TEST_DATABASE_URL=postgresql+asyncpg://ktm2000_user:ktm2000_pass_test@localhost:5441/ktm2000_e2e

# --- Приложение ---
ENV=dev
SECRET_KEY=ktm2000-e2e-secret-change-me
JWT_SECRET_KEY=ktm2000-e2e-jwt-secret-change-me
DEV_BYPASS_AUTH=true
# Стенд E2E чистит производство между тестами через POST
# /api/production-plans/reset-all — ручка открыта только этим флагом и ролью
# admin (issue #234).
ALLOW_PRODUCTION_RESET=true
DEFAULT_TIMEZONE=Europe/Moscow
# Break Glass — вход, которым заходит E2E (тот же пароль, что в dev, стенд
# локальный и без внешнего IdP).
BREAK_GLASS_ENABLED=true
BREAK_GLASS_USER=emergency_admin
BREAK_GLASS_PASSWORD=break-glass-dev
# AuthentIK стенду не нужен: e2e заходит через Break Glass, и поднятый рядом
# ИДП не должен влиять на прогон.
AUTH_OIDC_ENABLED=false

# Свой корневой каталог хранилища (ADR-0026): импорты xlsx и фото E2E не
# пишут в `data/storage-dev` чужого дерева. Путь — от каталога `backend/`.
STORAGE_ROOT=../data/storage-e2e

# CORS: обычный путь UI идёт через vite-прокси, CORS не касается. Значение не
# задаётся намеренно: origin frontend на стенде заранее неизвестен (порт
# выбирается на каждый прогон), поэтому обёртка [`run-e2e.mjs`](frontend/scripts/run-e2e.mjs)
# дописывает реальный origin в `CORS_ORIGINS` окружения — а переменная
# окружения важнее файла. Без обёртки (ручной стенд) действует дефолт
# `CORS_ORIGINS=*`: стенд локальный, куки не используются
# (`allow_credentials=False`), так что это не расширяет доступ.
