# === KTM-2000 E2E-стенд ===
# Источник правды для стенда Playwright: отдельная БД, отдельные порты,
# отдельное файловое хранилище. Общая dev-БД (`.env.dev`, 5440) и devstack
# (8012/5172) стенду не принадлежат — прогон идёт параллельно с чужой работой.
#
# Файл закоммичен: секретов здесь нет (тестовый Postgres, пароль из
# docker-compose.test.yml), а копировать его руками перед прогоном не нужно.
# Переопределение на уровне окружения работает: переменная из process.env
# важнее значения ниже (из файла добираются только те, которых нет в окружении).

# --- Адреса стенда ---
# Конфиг Playwright (`frontend/playwright.config.ts`) читает их отсюда и
# поднимает backend/frontend на этих портах. Прогон против уже поднятого
# стека — `PW_REUSE_STACK=1` вместе с ручным `E2E_API_URL`/`PLAYWRIGHT_TEST_BASE_URL`.
E2E_API_URL=http://localhost:8013/api
PLAYWRIGHT_TEST_BASE_URL=http://localhost:5173

# --- База данных: отдельная, на тестовом Postgres (не dev!) ---
# Тот же Postgres, что у pytest-прогонов (docker-compose.test.yml, 5441),
# но своя база: прогоны E2E не видят и не чистят БД друг друга.
# `npm run db:e2e:create` (scripts/e2e-db.py) создаёт её и отказывается
# работать, если DSN нацелен на общую dev-БД.
DATABASE_URL=postgresql+asyncpg://ktm2000_user:ktm2000_pass_test@localhost:5441/ktm2000_e2e
E2E_TEST_DATABASE_URL=postgresql+asyncpg://ktm2000_user:ktm2000_pass_test@localhost:5441/ktm2000_e2e

# --- Приложение ---
ENV=dev
SECRET_KEY=ktm2000-e2e-secret-change-me
JWT_SECRET_KEY=ktm2000-e2e-jwt-secret-change-me
DEV_BYPASS_AUTH=true
DEFAULT_TIMEZONE=Europe/Moscow
# Break Glass — вход, которым заходит E2E (тот же пароль, что в dev, стенд
# локальный и без внешнего IdP).
BREAK_GLASS_ENABLED=true
BREAK_GLASS_USER=emergency_admin
BREAK_GLASS_PASSWORD=break-glass-dev
# AuthentIK стенду не нужен: e2e заходит через Break Glass, и поднятый рядом
# ИДП не должен влиять на прогон.
AUTH_OIDC_ENABLED=false

# Свой корневой каталог хранилища (ADR-0026): импорты xlsx и фото E2E не
# пишут в `data/storage-dev` чужого дерева. Путь — от каталога `backend/`.
STORAGE_ROOT=../data/storage-e2e

# CORS для прямых обращений к API; обычный путь — через vite-прокси.
CORS_ORIGINS=http://localhost:5173
