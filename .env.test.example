# === KTM-2000 — тестовое окружение (ПРИМЕР) ===
#
# Это `.env.test.example`, а не рабочий `.env.test`. Рабочий файл **не
# отслеживается** и в свежем worktree отсутствует, а нужен почти каждому:
# `db:e2e:*` (тестовый Postgres на 5441) и launcher pytest читают его через
# `docker compose --env-file .env.test`.
#
# Без него прогон падает на ровном месте:
#
#   couldn't find env file: <worktree>/.env.test
#
# Как пользоваться: скопируй рядом с `.env.test` и подставь свои креды.
#
#     cp .env.test.example .env.test
#
# Значения ниже — тестовые и безопасные: тестовый Postgres на 5441 не
# виден с другой машины, а секреты помечены `change-me`. Прежде чем пустить
# это в прод-контейнер, замени `OPS_PUBLIC_IP` и секреты.

# --- Postgres тестового стенда ---
# Порт 5441 — тестовый. 5440 — dev-БД владельца, её этот файл не касается.
POSTGRES_USER=ktm2000_user
POSTGRES_PASSWORD=ktm2000_pass_test
POSTGRES_DB=ktm2000_test
POSTGRES_PORT=5441
DEV_POSTGRES_PORT=5440
POSTGRES_CONTAINER_NAME=ktm2000-postgres-prod
DATABASE_URL=postgresql+asyncpg://ktm2000_user:ktm2000_pass_test@localhost:5441/ktm2000_test

# --- Прод-контейнер (не стенд e2e) ---
OPS_PUBLIC_IP=192.168.100.200
EXTERNAL_PORT=8082
BASE_URL=http://${OPS_PUBLIC_IP}:8082
APP_PUBLIC_URL=http://${OPS_PUBLIC_IP}:8082/api
BACKEND_INTERNAL_URL=http://backend:8000
CORS_ORIGINS=*

# --- Приложение ---
ENV=test
DEV_BYPASS_AUTH=true
SECRET_KEY=change-me-app-secret-key-min-40-chars
JWT_SECRET_KEY=change-me-ktm-jwt-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
BREAK_GLASS_ENABLED=true
BREAK_GLASS_USER=emergency_admin
BREAK_GLASS_PASSWORD=change-me-break-glass-password

# --- Пул и логи ---
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
SQL_ECHO=false