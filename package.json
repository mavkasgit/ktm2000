{
  "name": "ktm-2000",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "npm install && npm install --prefix frontend && echo 'Не забудьте установить зависимости Python!'",
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs --fast",
    "gate:e2e": "node scripts/gate.mjs --e2e",
    "check:registry": "node scripts/check-registry.mjs",
    "toolchain:write": "node scripts/check-registry.mjs --write-doc",
    "prove-checks": "node scripts/prove-checks.mjs",
    "test-count": "node scripts/test-count.js",
    "hooks:install": "lefthook install",
    "hooks:check": "node scripts/check-hooks.mjs",
    "guard:tree": "node scripts/guard-tree.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify:sync": "node scripts/verify-sync.mjs --other ../hrms",
    "predev": "node scripts/verify-sync.mjs --other ../hrms --if-enabled && node scripts/ensure-dev-ports.js --kill && npm run db:up && npm run db:wait && npm run db:migrate",
    "prebuild": "node scripts/verify-sync.mjs --other ../hrms --if-enabled",
    "dev": "concurrently --names \"DB,BACKEND,FRONTEND\" -c \"blue,green,yellow\" \"npm run db:logs\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm --prefix frontend run dev",
    "lint": "npm --prefix frontend run lint",
    "backend": "cd backend && python scripts/dev_server.py",
    "dev:ports": "node scripts/ensure-dev-ports.js --check",
    "ports:check": "node ../_ports/check-ports.mjs",
    "dev:kill": "node scripts/ensure-dev-ports.js --kill",
    "devkill": "npm run dev:kill",
    "devrestart": "npm run dev:kill && npm run dev",
    "db:up": "docker compose --env-file .env.dev -f infra/compose/docker-compose.dev.yml up -d",
    "db:down": "docker compose --env-file .env.dev -f infra/compose/docker-compose.dev.yml down",
    "db:logs": "docker compose --env-file .env.dev -f infra/compose/docker-compose.dev.yml logs -f",
    "db:wait": "powershell -ExecutionPolicy Bypass -File scripts/wait-for-container-health.ps1 ktm2000-postgres",
    "db:migrate": "cd backend && alembic upgrade head",
    "db:e2e:up": "docker compose --env-file .env.test -f infra/compose/docker-compose.test.yml up -d postgres",
    "db:e2e:wait": "powershell -ExecutionPolicy Bypass -File scripts/wait-for-container-health.ps1 ktm2000-postgres-test",
    "db:e2e:create": "python scripts/e2e-db.py ensure",
    "db:e2e:prep-db": "python scripts/e2e-db.py prep",
    "db:e2e:drop": "python scripts/e2e-db.py drop",
    "db:e2e:migrate": "node scripts/with-env-file.mjs --cwd backend -- alembic upgrade head",
    "db:e2e:seed": "node scripts/with-env-file.mjs --cwd backend -- python scripts/seed_all.py --force",
    "db:makemigrate": "cd backend && alembic revision --autogenerate -m",
    "db:seed": "cd backend && python scripts/seed_all.py",
    "db:seed:packing-demo": "cd backend && python scripts/seed_packing_demo.py",
    "db:snapshot": "cd backend && python scripts/db_snapshot.py",
    "imports:sweep": "cd backend && python scripts/import_orphan_sweep.py",
    "gen:labels": "cd backend && python scripts/generate_frontend_labels.py",
    "gen:labels:check": "cd backend && python scripts/generate_frontend_labels.py --check",
    "test:up": "docker compose --env-file .env.test -f infra/compose/docker-compose.test.yml up -d --build",
    "test:down": "docker compose --env-file .env.test -f infra/compose/docker-compose.test.yml down",
    "test:logs": "docker compose --env-file .env.test -f infra/compose/docker-compose.test.yml logs -f",
    "test:db:up": "docker compose --env-file .env.test -f infra/compose/docker-compose.test.yml up -d postgres",
    "test:db:wait": "powershell -ExecutionPolicy Bypass -File scripts/wait-for-container-health.ps1 ktm2000-postgres-test",
    "test:db:down": "docker compose --env-file .env.test -f infra/compose/docker-compose.test.yml stop postgres",
    "test:db:cleanup": "python scripts/test-db.py cleanup",
    "test:pytest": "node scripts/heavy.mjs -- powershell -ExecutionPolicy Bypass -File scripts/test-run.ps1",
    "test:pytest:full": "node scripts/heavy.mjs -- powershell -ExecutionPolicy Bypass -File scripts/test-run.ps1 --full",
    "test:pytest:mon": "node scripts/heavy.mjs -- powershell -ExecutionPolicy Bypass -File scripts/test-run.ps1 --mon",
    "test:pytest:lf": "node scripts/heavy.mjs -- powershell -ExecutionPolicy Bypass -File scripts/test-run.ps1 --lf",
    "test:scripts": "node scripts/heavy.mjs -- node --test \"scripts/**/*.test.js\"",
    "check:docs": "node scripts/check-doc-links.js",
    "check:adr": "node scripts/check-adr.js",
    "check:dev-deps": "node scripts/check-dev-deps.js",
    "check:freshness": "node scripts/freshness.js",
    "test:hygiene": "python scripts/check-test-imports.py",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:e2e:ui": "npm --prefix frontend run test:e2e:ui",
    "test:e2e:smoke": "npm --prefix frontend run test:e2e:smoke",
    "test:e2e:mobile": "npm --prefix frontend run test:e2e:mobile",
    "test:tunnel:up": "docker compose --env-file .env.test -f infra/compose/docker-compose.test.yml --profile tunnel up -d --build",
    "prod:up": "docker compose --env-file .env.prod -f infra/compose/docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose --env-file .env.prod -f infra/compose/docker-compose.prod.yml down",
    "prod:logs": "docker compose --env-file .env.prod -f infra/compose/docker-compose.prod.yml logs -f",
    "prod:tunnel:up": "docker compose --env-file .env.prod -f infra/compose/docker-compose.prod.yml --profile tunnel up -d --build"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "concurrently": "^9.1.2",
    "lefthook": "^2.2.2"
  }
}
